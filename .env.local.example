# Configuration Supabase (FayJàng)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique
# Clé serveur, contourne la RLS : réservée à /admin, à l'inscription d'une école et au diagnostic
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-privee
# Clé privée ES256 (JWK, sur une seule ligne) importée dans Supabase > Project Settings > JWT Keys :
# le serveur signe avec elle les JWT courts lus par les politiques RLS. Générer avec :
#   npx supabase gen signing-key --algorithm ES256
SUPABASE_JWT_PRIVATE_KEY=

# Configuration App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session École (cookie signé) — générer avec : openssl rand -hex 32
ECOLE_SESSION_SECRET=

# Console SuperAdmin /admin (12 caractères minimum) — générer avec : openssl rand -hex 16
SUPERADMIN_CODE=

# Numéro Wave affiché aux écoles pour régler l'abonnement FayJàng (optionnel)
WAVE_NUMERO_PAIEMENT=

# Protège /api/diagnostic en production : appeler avec l'en-tête x-diagnostic-secret (openssl rand -hex 32)
DIAGNOSTIC_SECRET=
